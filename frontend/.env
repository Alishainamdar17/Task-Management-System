# FRONTEND URL for production (Render, Vercel, etc.)
CLIENT_URL=https://your-production-site.com

# Extra origins (optional, comma-separated)
EXTRA_ALLOWED_ORIGINS=

# If you use cookies/tokens withCredentials:true
CORS_ALLOW_CREDENTIALS=false

# Port (local)
PORT=8000

# Local frontend base API (used by Vite)
VITE_API_BASE=http://localhost:8000/api
